<!DOCTYPE html>
<html lang="en" data-theme="precision">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Frao Advisor Dashboard</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%2306b6d4'/%3E%3Ctext x='16' y='23' text-anchor='middle' font-size='20' font-weight='bold' fill='%23fff'%3EF%3C/text%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <script src="/static/chart.umd.min.js"></script>
  <link rel="stylesheet" href="/static/style.css">
  <script>
    // Restore the saved theme before first paint (avoids a flash of the wrong theme).
    (function () {
      var t;
      try { t = localStorage.getItem('frao-advisor-theme'); } catch (e) {}
      if (t !== 'precision' && t !== 'neutral' && t !== 'observatory') { t = 'precision'; }
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
</head>
<body
  data-signals="section:'overview';typeFilter:'all';expertFilter:'all';offset:0"
>
  <div class="layout">
    <nav class="sidebar" aria-label="Main navigation">
      <div class="brand">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 1.8l1.9 8.3 8.3 1.9-8.3 1.9-1.9 8.3-1.9-8.3-8.3-1.9 8.3-1.9z"/></svg>
        </span>
        <span class="brand-text">
          <span class="brand-name">Frao Advisor</span>
          <span class="brand-tagline">expert counsel, on demand</span>
        </span>
        <span class="live-dot" title="Live"></span>
      </div>

      <div class="nav-items">
        <a href="#" data-nav="overview" data-on-click="$$get('/dashboard/overview')" class="nav-item">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          <span>Overview</span>
        </a>
        <a href="#" data-nav="timeline" data-on-click="$$get('/dashboard/timeline')" class="nav-item">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>Timeline</span>
        </a>
        <a href="#" data-nav="experts" data-on-click="$$get('/dashboard/experts')" class="nav-item">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span>Experts</span>
        </a>
        <a href="#" data-nav="deliberations" data-on-click="$$get('/dashboard/deliberations')" class="nav-item">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M6 21V9a9 9 0 0 0 9 9"/></svg>
          <span>Deliberations</span>
        </a>
        <a href="#" data-nav="costs" data-on-click="$$get('/dashboard/costs')" class="nav-item">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          <span>Costs</span>
        </a>
        <a href="#" data-nav="metrics" data-on-click="$$get('/dashboard/metrics')" class="nav-item">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          <span>Metrics</span>
        </a>
        <a href="http://10.64.0.5:9763/" target="_blank" rel="noopener" class="nav-item">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          <span>Orchestrator</span>
        </a>
      </div>

      <div class="sidebar-footer">
        <div class="theme-label">Theme</div>
        <div class="theme-switcher" role="group" aria-label="Theme">
          <button type="button" class="theme-btn" data-theme="precision" onclick="setAdvisorTheme('precision')">Precision</button>
          <button type="button" class="theme-btn" data-theme="neutral" onclick="setAdvisorTheme('neutral')">Neutral</button>
          <button type="button" class="theme-btn" data-theme="observatory" onclick="setAdvisorTheme('observatory')">Observatory</button>
        </div>
      </div>
    </nav>

    <main class="content" id="content" aria-label="Dashboard content">
      <div class="loading" id="initial-loading">Loading dashboard...</div>
    </main>
  </div>

  <nav class="mobile-bar" id="mobile-bar" aria-label="Mobile navigation">
    <a href="#" data-nav="overview" data-on-click="$$get('/dashboard/overview')" class="mobile-item">
      <svg class="mobile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      <span>Overview</span>
    </a>
    <a href="#" data-nav="timeline" data-on-click="$$get('/dashboard/timeline')" class="mobile-item">
      <svg class="mobile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>Timeline</span>
    </a>
    <a href="#" data-nav="experts" data-on-click="$$get('/dashboard/experts')" class="mobile-item">
      <svg class="mobile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      <span>Experts</span>
    </a>
    <a href="#" data-nav="costs" data-on-click="$$get('/dashboard/costs')" class="mobile-item">
      <svg class="mobile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
      <span>Costs</span>
    </a>
    <a href="#" data-nav="metrics" data-on-click="$$get('/dashboard/metrics')" class="mobile-item">
      <svg class="mobile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      <span>Metrics</span>
    </a>
    <button type="button" class="mobile-theme" onclick="cycleAdvisorTheme()" title="Cycle theme" aria-label="Cycle theme">
      <svg class="mobile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <span class="mobile-theme-label">Theme</span>
    </button>
  </nav>

  <script defer src="/static/dashboard.js"></script>
</body>
</html>
