<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Frao Advisor Dashboard</title>
  <script type="module" src="https://cdn.jsdelivr.net/npm/@starfederation/datastar@v1.2.2/dist/datastar.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body
  data-signals="section:'overview';range:'all';typeFilter:'all';expertFilter:'all';limit:20;offset:0"
>
  <div class="layout">
    <!-- ─── Sidebar (desktop) ─── -->
    <nav class="sidebar">
      <div class="brand">
        <span class="live-dot"></span>
        Frao Advisor
      </div>
      <div class="nav-items">
        <a href="#" data-on-click="$$set('section','overview');$$get('/dashboard/overview')" class="nav-item">
          <span class="nav-icon">&#9632;</span> Overview
        </a>
        <a href="#" data-on-click="$$set('section','timeline');$$get('/dashboard/timeline')" class="nav-item">
          <span class="nav-icon">&#9776;</span> Timeline
        </a>
        <a href="#" data-on-click="$$set('section','experts');$$get('/dashboard/experts')" class="nav-item">
          <span class="nav-icon">&#9733;</span> Experts
        </a>
        <a href="#" data-on-click="$$set('section','deliberations');$$get('/dashboard/deliberations')" class="nav-item">
          <span class="nav-icon">&#9671;</span> Deliberations
        </a>
        <a href="#" data-on-click="$$set('section','costs');$$get('/dashboard/costs')" class="nav-item">
          <span class="nav-icon">&#36;</span> Costs
        </a>
        <a href="#" data-on-click="$$set('section','metrics');$$get('/dashboard/metrics')" class="nav-item">
          <span class="nav-icon">&#9608;</span> Metrics
        </a>
      </div>
    </nav>

    <!-- ─── Main Content ─── -->
    <main class="content" id="content">
      <div class="loading">Loading dashboard...</div>
    </main>
  </div>

  <!-- ─── Mobile Bottom Bar ─── -->
  <nav class="mobile-bar" id="mobile-bar">
    <a href="#" data-on-click="$$set('section','overview');$$get('/dashboard/overview')" class="mobile-item">
      <span class="mobile-icon">&#9632;</span>
      <span class="mobile-label">Overview</span>
    </a>
    <a href="#" data-on-click="$$set('section','timeline');$$get('/dashboard/timeline')" class="mobile-item">
      <span class="mobile-icon">&#9776;</span>
      <span class="mobile-label">Timeline</span>
    </a>
    <a href="#" data-on-click="$$set('section','experts');$$get('/dashboard/experts')" class="mobile-item">
      <span class="mobile-icon">&#9733;</span>
      <span class="mobile-label">Experts</span>
    </a>
    <a href="#" data-on-click="$$set('section','costs');$$get('/dashboard/costs')" class="mobile-item">
      <span class="mobile-icon">&#36;</span>
      <span class="mobile-label">Costs</span>
    </a>
    <a href="#" data-on-click="$$set('section','metrics');$$get('/dashboard/metrics')" class="mobile-item">
      <span class="mobile-icon">&#9608;</span>
      <span class="mobile-label">Metrics</span>
    </a>
  </nav>

  <!-- ─── Global Chart Framework ─── -->
  <script>
  window.FraoDashboard = {
    charts: {},
    destroy: function(id) {
      if (this.charts[id]) { try { this.charts[id].destroy(); } catch(e) {} delete this.charts[id]; }
    },
    create: function(id, config) {
      this.destroy(id);
      var el = document.getElementById(id);
      if (!el) return;
      var ctx = el.getContext('2d');
      if (!ctx) return;
      try { this.charts[id] = new Chart(ctx, config); } catch(e) { console.warn('chart:', id, e); }
    },
    bar: function(id, labels, values, label, color) {
      this.create(id, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [{ label: label || '', data: values, backgroundColor: color || 'rgba(6,182,212,0.7)', borderRadius: 4 }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { color: 'rgba(148,163,184,0.1)' }, ticks: { color: '#94a3b8' } },
            y: { grid: { color: 'rgba(148,163,184,0.1)' }, ticks: { color: '#94a3b8' } }
          }
        }
      });
    },
    pie: function(id, labels, values) {
      this.create(id, {
        type: 'pie',
        data: {
          labels: labels,
          datasets: [{ data: values, backgroundColor: ['#06b6d4','#f59e0b','#10b981','#8b5cf6','#ef4444','#ec4899','#14b8a6','#f97316'] }]
        },
        options: { responsive: true, plugins: { legend: { labels: { color: '#94a3b8', padding: 12 } } } }
      });
    },
    line: function(id, labels, values, label, fill) {
      this.create(id, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [{
            label: label || '', data: values,
            borderColor: '#06b6d4', backgroundColor: fill !== false ? 'rgba(6,182,212,0.1)' : 'transparent',
            fill: fill !== false, tension: 0.3, pointRadius: 2, pointHoverRadius: 5
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: false }, ticks: { color: '#94a3b8', maxTicksLimit: 12 } },
            y: { grid: { color: 'rgba(148,163,184,0.1)' }, ticks: { color: '#94a3b8' } }
          }
        }
      });
    },
    gauge: function(id, value, max, label) {
      this.create(id, {
        type: 'doughnut',
        data: {
          datasets: [{
            data: [value, Math.max(0, max - value)],
            backgroundColor: ['#06b6d4', 'rgba(148,163,184,0.15)'],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true, cutout: '80%',
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function() { return (label || 'Value') + ': ' + value.toFixed(4); }
              }
            }
          }
        }
      });
    },
    sparkline: function(id, values) {
      var labels = values.map(function(_, i) { return i + ''; });
      this.create(id, {
        type: 'line',
        data: { labels: labels, datasets: [{ data: values, borderColor: '#06b6d4', backgroundColor: 'transparent', borderWidth: 2, pointRadius: 0, fill: false, tension: 0.4 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { enabled: false } }, scales: { x: { display: false }, y: { display: false } } }
      });
    }
  };
  addEventListener('DOMContentLoaded', function() {
    setTimeout(function() { Datastar.get('/dashboard/overview'); }, 50);
  });
  </script>
</body>
</html>
