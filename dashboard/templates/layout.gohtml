<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Frao Advisor Dashboard</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%2306b6d4'/%3E%3Ctext x='16' y='23' text-anchor='middle' font-size='20' font-weight='bold' fill='%23fff'%3EF%3C/text%3E%3C/svg%3E">
  <script src="/static/chart.umd.min.js"></script>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body
  data-signals="section:'overview';typeFilter:'all';expertFilter:'all';offset:0"
>
  <div class="layout">
    <nav class="sidebar" aria-label="Main navigation">
      <div class="brand">
        <span class="live-dot"></span>
        Frao Advisor
      </div>
      <div class="nav-items">
        <a href="#" data-on-click="$$get('/dashboard/overview')" class="nav-item">Overview</a>
        <a href="#" data-on-click="$$get('/dashboard/timeline')" class="nav-item">Timeline</a>
        <a href="#" data-on-click="$$get('/dashboard/experts')" class="nav-item">Experts</a>
        <a href="#" data-on-click="$$get('/dashboard/deliberations')" class="nav-item">Deliberations</a>
        <a href="#" data-on-click="$$get('/dashboard/costs')" class="nav-item">Costs</a>
        <a href="#" data-on-click="$$get('/dashboard/metrics')" class="nav-item">Metrics</a>
        <a href="http://localhost:9763/" target="_blank" class="nav-item">Orchestrator</a>
      </div>
    </nav>

    <main class="content" id="content" aria-label="Dashboard content">
      <div class="loading" id="initial-loading">Loading dashboard...</div>
    </main>
  </div>

  <nav class="mobile-bar" id="mobile-bar">
    <a href="#" data-on-click="$$get('/dashboard/overview')" class="mobile-item">Overview</a>
    <a href="#" data-on-click="$$get('/dashboard/timeline')" class="mobile-item">Timeline</a>
    <a href="#" data-on-click="$$get('/dashboard/experts')" class="mobile-item">Experts</a>
    <a href="#" data-on-click="$$get('/dashboard/costs')" class="mobile-item">Costs</a>
    <a href="#" data-on-click="$$get('/dashboard/metrics')" class="mobile-item">Metrics</a>
    <a href="http://localhost:9763/" target="_blank" class="mobile-item">Orch.</a>
  </nav>

  <script defer src="/static/dashboard.js"></script>
</body>
</html>